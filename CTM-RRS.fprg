<?xml version="1.0"?>
<flowgorithm fileversion="2.11">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="canse"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-29 03:29:14 pm"/>
        <attribute name="created" value="Y2Fuc2U7Q0RPOzIwMjYtMTAtMDk7MTE6NDA6MTggcG07MjA3OQ=="/>
        <attribute name="edited" value="Y2Fuc2U7Q0RPOzIwMjYtMTAtMjk7MDM6Mjk6MTQgcG07OTsyMjAx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="route, problem, reportTime, status, recommendation, anotherReport" type="String" array="False" size=""/>
            <declare name="severity, reportCount" type="Integer" array="False" size=""/>
            <assign variable="reportCount" expression="0"/>
            <output expression="&quot;COMMUNITY TRANSPORTATION ROUTE=REPORTING SYSTEM&quot;" newline="True"/>
            <do expression="anotherReport == &quot;yes&quot;">
                <output expression="&quot;Enter route location&quot;" newline="True"/>
                <input variable="route"/>
                <output expression="&quot;Enter problem type&quot;" newline="True"/>
                <input variable="problem"/>
                <output expression="&quot;Enter severity (1=Low,2=Medium,3=High):&quot;" newline="True"/>
                <input variable="severity"/>
                <output expression="&quot;Enter report time&quot;" newline="True"/>
                <input variable="reportTime"/>
                <if expression="route=&quot;&quot;&#13;&#10;or problem=&quot;&quot;&#13;&#10;or reportTime=&quot;&quot;">
                    <then>
                        <output expression="&quot;Please provide all required information&quot;" newline="True"/>
                    </then>
                    <else>
                        <assign variable="Status" expression="&quot;&quot;"/>
                        <if expression="severity=1">
                            <then>
                                <assign variable="status" expression="&quot;Normal/MinorDelay&quot;"/>
                                <assign variable="recommendation" expression="&quot;Travel normally,stay alert&quot;"/>
                            </then>
                            <else>
                                <if expression="severity=2">
                                    <then>
                                        <assign variable="status" expression="&quot;Moderate Delay&quot;"/>
                                        <assign variable="recommendation" expression="&quot;Consider another route&quot;"/>
                                    </then>
                                    <else>
                                        <if expression="severity=3">
                                            <then>
                                                <assign variable="status" expression="&quot;Severe Delay&quot;"/>
                                                <assign variable="recommendation" expression="&quot;Avoid route if possible&quot;"/>
                                            </then>
                                            <else>
                                                <output expression="&quot;Invalid severity. Enter 1,2 or 3&quot;" newline="True"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                        <if expression="status &lt;&gt;&quot;&quot;">
                            <then>
                                <assign variable="reportCount" expression="reportCount + 1"/>
                                <output expression="&quot;Report saved. Status: &quot; &amp; status" newline="True"/>
                                <output expression="&quot;Advice: &quot; &amp; recommendation" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Add another report? (Yes/No)&quot;" newline="True"/>
                <input variable="anotherReport"/>
            </do>
            <output expression="&quot;Thank you for using CTM-RRS.&#13;&#10;Reports saved: &quot;&amp; reportCount" newline="True"/>
        </body>
    </function>
</flowgorithm>
